# dependencies & caches
node_modules/
__pycache__/
# render intermediates (regenerable)
aitrends-2d-studio/projects/*/build/
aitrends-2d-studio/examples/*/build/
# narration scratch (the mastered voiceover lives in the project's input/)
narration/samples/
narration/out/*.wav
narration/voiceover_preview.mp3
*.log
# full-quality master is >100 MB (GitHub limit); the repo keeps the *_web.mp4 copy
aitrends-2d-studio/projects/*/out/*.mp4
!aitrends-2d-studio/projects/*/out/*_web.mp4
