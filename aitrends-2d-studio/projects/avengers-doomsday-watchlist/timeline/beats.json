[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.35,
  "speechEnd": 2.819,
  "text": "Stop watching every single Marvel movie!",
  "end": 3.032
 },
 {
  "i": 1,
  "start": 3.032,
  "speechStart": 3.182,
  "speechEnd": 5.007,
  "text": "Because if you're planning to watch Avengers:",
  "end": 5.292
 },
 {
  "i": 2,
  "start": 5.292,
  "speechStart": 5.442,
  "speechEnd": 9.685,
  "text": "Doomsday, you don't need to spend weeks rewatching the entire MCU.",
  "end": 9.878
 },
 {
  "i": 3,
  "start": 9.878,
  "speechStart": 10.028,
  "speechEnd": 13.228,
  "text": "But there are a few movies you absolutely should prioritize.",
  "end": 13.452
 },
 {
  "i": 4,
  "start": 13.452,
  "speechStart": 13.602,
  "speechEnd": 17.249,
  "text": "From the return of legendary heroes to the arrival of Doctor Doom,",
  "end": 17.642
 },
 {
  "i": 5,
  "start": 17.642,
  "speechStart": 17.792,
  "speechEnd": 20.282,
  "text": "these movies could make a huge difference in",
  "end": 20.147
 },
 {
  "i": 6,
  "start": 20.147,
  "speechStart": 20.297,
  "speechEnd": 22.989,
  "text": "how you experience Marvel's next massive crossover.",
  "end": 23.213
 },
 {
  "i": 7,
  "start": 23.213,
  "speechStart": 23.363,
  "speechEnd": 27.249,
  "text": "So, here are the 6 movies you should watch before Avengers: Doomsday!",
  "end": 27.462
 },
 {
  "i": 8,
  "start": 27.462,
  "speechStart": 27.612,
  "speechEnd": 30.496,
  "text": "And trust me, the last one is especially important.",
  "end": 31.126
 },
 {
  "i": 9,
  "start": 31.126,
  "speechStart": 31.276,
  "speechEnd": 33.826,
  "text": "Let's start with Thunderbolts. Why?",
  "end": 33.969
 },
 {
  "i": 10,
  "start": 33.969,
  "speechStart": 34.119,
  "speechEnd": 37.399,
  "text": "Because the Avengers aren't the only team in the game anymore.",
  "end": 37.623
 },
 {
  "i": 11,
  "start": 37.623,
  "speechStart": 37.773,
  "speechEnd": 40.676,
  "text": "This movie brings together a group of morally complicated",
  "end": 40.564
 },
 {
  "i": 12,
  "start": 40.564,
  "speechStart": 40.714,
  "speechEnd": 43.933,
  "text": "characters who eventually become the New Avengers.",
  "end": 44.153
 },
 {
  "i": 13,
  "start": 44.153,
  "speechStart": 44.303,
  "speechEnd": 46.66,
  "text": "And with characters like Yelena Belova,",
  "end": 46.863
 },
 {
  "i": 14,
  "start": 46.863,
  "speechStart": 47.013,
  "speechEnd": 49.599,
  "text": "Bucky Barnes, and Sentry entering the bigger picture,",
  "end": 50.083
 },
 {
  "i": 15,
  "start": 50.083,
  "speechStart": 50.233,
  "speechEnd": 53.986,
  "text": "this team could be extremely important when the next major threat arrives.",
  "end": 54.205
 },
 {
  "i": 16,
  "start": 54.205,
  "speechStart": 54.355,
  "speechEnd": 56.253,
  "text": "Because when Doctor Doom comes knocking,",
  "end": 56.575
 },
 {
  "i": 17,
  "start": 56.575,
  "speechStart": 56.725,
  "speechEnd": 59.121,
  "text": "the world might need a very different kind of hero.",
  "end": 59.74
 },
 {
  "i": 18,
  "start": 59.74,
  "speechStart": 59.89,
  "speechEnd": 61.76,
  "text": "Next up, Deadpool & Wolverine.",
  "end": 61.992
 },
 {
  "i": 19,
  "start": 61.992,
  "speechStart": 62.142,
  "speechEnd": 65.978,
  "text": "And this one is important for one massive reason: the multiverse.",
  "end": 66.209
 },
 {
  "i": 20,
  "start": 66.209,
  "speechStart": 66.359,
  "speechEnd": 70.764,
  "text": "This movie connects Deadpool and Wolverine's world to the larger Marvel multiverse",
  "end": 70.647
 },
 {
  "i": 21,
  "start": 70.647,
  "speechStart": 70.797,
  "speechEnd": 72.983,
  "text": "and brings the legacy of Fox's",
  "end": 72.848
 },
 {
  "i": 22,
  "start": 72.848,
  "speechStart": 72.998,
  "speechEnd": 75.348,
  "text": "Marvel characters into the conversation.",
  "end": 75.58
 },
 {
  "i": 23,
  "start": 75.58,
  "speechStart": 75.73,
  "speechEnd": 78.21,
  "text": "And here's why that matters. Avengers:",
  "end": 78.209
 },
 {
  "i": 24,
  "start": 78.209,
  "speechStart": 78.359,
  "speechEnd": 81.003,
  "text": "Doomsday features legendary X-Men characters,",
  "end": 81.269
 },
 {
  "i": 25,
  "start": 81.269,
  "speechStart": 81.419,
  "speechEnd": 84.325,
  "text": "including Professor X, Magneto, and Cyclops.",
  "end": 84.52
 },
 {
  "i": 26,
  "start": 84.52,
  "speechStart": 84.67,
  "speechEnd": 87.462,
  "text": "That means the old Marvel universe could collide with the",
  "end": 87.325
 },
 {
  "i": 27,
  "start": 87.325,
  "speechStart": 87.475,
  "speechEnd": 90.851,
  "text": "MCU in a way we've never seen before.",
  "end": 91.072
 },
 {
  "i": 28,
  "start": 91.072,
  "speechStart": 91.222,
  "speechEnd": 93.921,
  "text": "And if you want to understand why these characters matter,",
  "end": 94.182
 },
 {
  "i": 29,
  "start": 94.182,
  "speechStart": 94.332,
  "speechEnd": 95.902,
  "text": "this is a great place to start.",
  "end": 96.515
 },
 {
  "i": 30,
  "start": 96.515,
  "speechStart": 96.665,
  "speechEnd": 98.225,
  "text": "Now things get dangerous.",
  "end": 98.706
 },
 {
  "i": 31,
  "start": 98.706,
  "speechStart": 98.856,
  "speechEnd": 103.231,
  "text": "Doctor Strange in the Multiverse of Madness explores alternate universes,",
  "end": 103.526
 },
 {
  "i": 32,
  "start": 103.526,
  "speechStart": 103.676,
  "speechEnd": 105.947,
  "text": "incursions, and the devastating",
  "end": 105.838
 },
 {
  "i": 33,
  "start": 105.838,
  "speechStart": 105.988,
  "speechEnd": 110.164,
  "text": "consequences of messing with realities beyond your own. An incursion is",
  "end": 110.027
 },
 {
  "i": 34,
  "start": 110.027,
  "speechStart": 110.177,
  "speechEnd": 114.616,
  "text": "when two universes collide in a way that can destroy one or both of them.",
  "end": 114.819
 },
 {
  "i": 35,
  "start": 114.819,
  "speechStart": 114.969,
  "speechEnd": 116.444,
  "text": "Think about that for a second.",
  "end": 117.104
 },
 {
  "i": 36,
  "start": 117.104,
  "speechStart": 117.254,
  "speechEnd": 120.182,
  "text": "What happens when multiple universes begin collapsing,",
  "end": 120.554
 },
 {
  "i": 37,
  "start": 120.554,
  "speechStart": 120.704,
  "speechEnd": 122.942,
  "text": "and the most powerful heroes from different",
  "end": 122.819
 },
 {
  "i": 38,
  "start": 122.819,
  "speechStart": 122.969,
  "speechEnd": 125.49,
  "text": "realities are forced to face the same enemy?",
  "end": 125.707
 },
 {
  "i": 39,
  "start": 125.707,
  "speechStart": 125.857,
  "speechEnd": 127.017,
  "text": "Could they work together?",
  "end": 127.237
 },
 {
  "i": 40,
  "start": 127.237,
  "speechStart": 127.387,
  "speechEnd": 129.456,
  "text": "Or could they end up destroying each other?",
  "end": 129.667
 },
 {
  "i": 41,
  "start": 129.667,
  "speechStart": 129.817,
  "speechEnd": 132.707,
  "text": "With the multiverse playing such a major role in this saga,",
  "end": 133.017
 },
 {
  "i": 42,
  "start": 133.017,
  "speechStart": 133.167,
  "speechEnd": 135.662,
  "text": "this movie gives you some valuable context.",
  "end": 136.286
 },
 {
  "i": 43,
  "start": 136.286,
  "speechStart": 136.436,
  "speechEnd": 138.434,
  "text": "If you haven't watched Avengers:",
  "end": 138.313
 },
 {
  "i": 44,
  "start": 138.313,
  "speechStart": 138.463,
  "speechEnd": 140.825,
  "text": "Infinity War, stop everything and watch it.",
  "end": 141.029
 },
 {
  "i": 45,
  "start": 141.029,
  "speechStart": 141.179,
  "speechEnd": 142.637,
  "text": "This is where we see what happens",
  "end": 142.506
 },
 {
  "i": 46,
  "start": 142.506,
  "speechStart": 142.656,
  "speechEnd": 146.86,
  "text": "when an enemy is powerful enough to defeat the Avengers at their own game.",
  "end": 147.069
 },
 {
  "i": 47,
  "start": 147.069,
  "speechStart": 147.219,
  "speechEnd": 149.296,
  "text": "Thanos doesn't just threaten the world.",
  "end": 149.322
 },
 {
  "i": 48,
  "start": 149.322,
  "speechStart": 149.472,
  "speechEnd": 151.381,
  "text": "He threatens the entire universe.",
  "end": 151.613
 },
 {
  "i": 49,
  "start": 151.613,
  "speechStart": 151.763,
  "speechEnd": 155.803,
  "text": "And the heroes discover that even their combined strength might not be enough.",
  "end": 156.014
 },
 {
  "i": 50,
  "start": 156.014,
  "speechStart": 156.164,
  "speechEnd": 158.401,
  "text": "Why is this important before Doomsday?",
  "end": 158.617
 },
 {
  "i": 51,
  "start": 158.617,
  "speechStart": 158.767,
  "speechEnd": 161.731,
  "text": "Because Doctor Doom is another villain whose threat",
  "end": 161.594
 },
 {
  "i": 52,
  "start": 161.594,
  "speechStart": 161.744,
  "speechEnd": 164.645,
  "text": "could bring heroes from different corners of Marvel together.",
  "end": 164.864
 },
 {
  "i": 53,
  "start": 164.864,
  "speechStart": 165.014,
  "speechEnd": 168.878,
  "text": "Infinity War reminds us that sometimes, the heroes don't win.",
  "end": 169.084
 },
 {
  "i": 54,
  "start": 169.084,
  "speechStart": 169.234,
  "speechEnd": 171.875,
  "text": "And sometimes, the consequences change everything.",
  "end": 172.514
 },
 {
  "i": 55,
  "start": 172.514,
  "speechStart": 172.664,
  "speechEnd": 175.265,
  "text": "Of course, you can't skip Avengers: Endgame.",
  "end": 175.487
 },
 {
  "i": 56,
  "start": 175.487,
  "speechStart": 175.637,
  "speechEnd": 179.376,
  "text": "This movie delivers the emotional conclusion to the Infinity Saga",
  "end": 179.247
 },
 {
  "i": 57,
  "start": 179.247,
  "speechStart": 179.397,
  "speechEnd": 182.777,
  "text": "and changes the future of the MCU forever.",
  "end": 182.996
 },
 {
  "i": 58,
  "start": 182.996,
  "speechStart": 183.146,
  "speechEnd": 185.534,
  "text": "It gives us the end of Tony Stark's journey,",
  "end": 185.826
 },
 {
  "i": 59,
  "start": 185.826,
  "speechStart": 185.976,
  "speechEnd": 188.072,
  "text": "the consequences of Thanos's actions,",
  "end": 188.316
 },
 {
  "i": 60,
  "start": 188.316,
  "speechStart": 188.466,
  "speechEnd": 190.672,
  "text": "and a major turning point for the Avengers.",
  "end": 190.888
 },
 {
  "i": 61,
  "start": 190.888,
  "speechStart": 191.038,
  "speechEnd": 192.712,
  "text": "And now, Robert Downey Jr.",
  "end": 192.576
 },
 {
  "i": 62,
  "start": 192.576,
  "speechStart": 192.726,
  "speechEnd": 195.313,
  "text": "is returning to Marvel as Doctor Doom.",
  "end": 195.518
 },
 {
  "i": 63,
  "start": 195.518,
  "speechStart": 195.668,
  "speechEnd": 198.766,
  "text": "Yes, the same actor who played Iron Man",
  "end": 198.627
 },
 {
  "i": 64,
  "start": 198.627,
  "speechStart": 198.777,
  "speechEnd": 203.027,
  "text": "is stepping into the role of one of Marvel's most dangerous villains. But remember:",
  "end": 203.313
 },
 {
  "i": 65,
  "start": 203.313,
  "speechStart": 203.463,
  "speechEnd": 207.669,
  "text": "Tony Stark and Victor von Doom are not automatically the same character.",
  "end": 207.888
 },
 {
  "i": 66,
  "start": 207.888,
  "speechStart": 208.038,
  "speechEnd": 210.877,
  "text": "How Marvel explains this casting choice is one of",
  "end": 210.741
 },
 {
  "i": 67,
  "start": 210.741,
  "speechStart": 210.891,
  "speechEnd": 213.447,
  "text": "the biggest mysteries surrounding the movie.",
  "end": 213.659
 },
 {
  "i": 68,
  "start": 213.659,
  "speechStart": 213.809,
  "speechEnd": 216.98,
  "text": "And Endgame makes that mystery even more fascinating.",
  "end": 217.619
 },
 {
  "i": 69,
  "start": 217.619,
  "speechStart": 217.769,
  "speechEnd": 222.007,
  "text": "And finally, the movie you should put right at the top of your watchlist:",
  "end": 221.88
 },
 {
  "i": 70,
  "start": 221.88,
  "speechStart": 222.03,
  "speechEnd": 224.585,
  "text": "The Fantastic Four: First Steps. Why?",
  "end": 224.907
 },
 {
  "i": 71,
  "start": 224.907,
  "speechStart": 225.057,
  "speechEnd": 227.476,
  "text": "Because Doctor Doom's history in Marvel comics",
  "end": 227.348
 },
 {
  "i": 72,
  "start": 227.348,
  "speechStart": 227.498,
  "speechEnd": 229.873,
  "text": "is deeply connected to the Fantastic Four,",
  "end": 230.187
 },
 {
  "i": 73,
  "start": 230.187,
  "speechStart": 230.337,
  "speechEnd": 231.86,
  "text": "especially Reed Richards.",
  "end": 232.075
 },
 {
  "i": 74,
  "start": 232.075,
  "speechStart": 232.225,
  "speechEnd": 234.643,
  "text": "Reed is one of Marvel's smartest characters,",
  "end": 234.955
 },
 {
  "i": 75,
  "start": 234.955,
  "speechStart": 235.105,
  "speechEnd": 237.63,
  "text": "while Doom combines extraordinary intelligence,",
  "end": 237.875
 },
 {
  "i": 76,
  "start": 237.875,
  "speechStart": 238.025,
  "speechEnd": 241.773,
  "text": "advanced technology, political power, and mastery of sorcery.",
  "end": 241.991
 },
 {
  "i": 77,
  "start": 241.991,
  "speechStart": 242.141,
  "speechEnd": 246.582,
  "text": "That makes their rivalry much more than a simple battle between a hero and a villain.",
  "end": 246.791
 },
 {
  "i": 78,
  "start": 246.791,
  "speechStart": 246.941,
  "speechEnd": 251.401,
  "text": "It's a clash between two brilliant minds with very different ideas about power",
  "end": 251.273
 },
 {
  "i": 79,
  "start": 251.273,
  "speechStart": 251.423,
  "speechEnd": 252.45,
  "text": "and the future.",
  "end": 252.67
 },
 {
  "i": 80,
  "start": 252.67,
  "speechStart": 252.82,
  "speechEnd": 257.055,
  "text": "This movie introduces Marvel's First Family and establishes their world,",
  "end": 257.01
 },
 {
  "i": 81,
  "start": 257.01,
  "speechStart": 257.16,
  "speechEnd": 260.975,
  "text": "making it one of the most relevant films to watch before Doomsday.",
  "end": 261.189
 },
 {
  "i": 82,
  "start": 261.189,
  "speechStart": 261.339,
  "speechEnd": 264.885,
  "text": "And with the Fantastic Four entering the larger Marvel story,",
  "end": 265.199
 },
 {
  "i": 83,
  "start": 265.199,
  "speechStart": 265.349,
  "speechEnd": 267.641,
  "text": "you definitely don't want to miss their introduction.",
  "end": 268.273
 },
 {
  "i": 84,
  "start": 268.273,
  "speechStart": 268.423,
  "speechEnd": 272.758,
  "text": "If you want a better understanding of the multiverse, watch Spider-Man:",
  "end": 272.638
 },
 {
  "i": 85,
  "start": 272.638,
  "speechStart": 272.788,
  "speechEnd": 273.865,
  "text": "No Way Home as well.",
  "end": 274.068
 },
 {
  "i": 86,
  "start": 274.068,
  "speechStart": 274.218,
  "speechEnd": 278.461,
  "text": "And if you want to understand the bigger story behind the TVA,",
  "end": 278.325
 },
 {
  "i": 87,
  "start": 278.325,
  "speechStart": 278.475,
  "speechEnd": 282.536,
  "text": "branching timelines, and He Who Remains, watch Loki Seasons 1 and 2.",
  "end": 282.739
 },
 {
  "i": 88,
  "start": 282.739,
  "speechStart": 282.889,
  "speechEnd": 287.313,
  "text": "They're not movies, but they provide useful background for the Multiverse Saga.",
  "end": 287.935
 },
 {
  "i": 89,
  "start": 287.935,
  "speechStart": 288.085,
  "speechEnd": 292.771,
  "text": "So, let's recap your essential movie watchlist: Number 6 Thunderbolts.",
  "end": 292.969
 },
 {
  "i": 90,
  "start": 292.969,
  "speechStart": 293.119,
  "speechEnd": 295.173,
  "text": "Number 5 Deadpool & Wolverine.",
  "end": 295.403
 },
 {
  "i": 91,
  "start": 295.403,
  "speechStart": 295.553,
  "speechEnd": 298.82,
  "text": "Number 4 Doctor Strange in the Multiverse of Madness.",
  "end": 299.033
 },
 {
  "i": 92,
  "start": 299.033,
  "speechStart": 299.183,
  "speechEnd": 301.674,
  "text": "Number 3 Avengers: Infinity War.",
  "end": 301.878
 },
 {
  "i": 93,
  "start": 301.878,
  "speechStart": 302.028,
  "speechEnd": 304.052,
  "text": "Number 2 Avengers: Endgame.",
  "end": 304.274
 },
 {
  "i": 94,
  "start": 304.274,
  "speechStart": 304.424,
  "speechEnd": 308.567,
  "text": "And number 1 The Fantastic Four: First Steps. Six movies.",
  "end": 308.715
 },
 {
  "i": 95,
  "start": 308.715,
  "speechStart": 308.865,
  "speechEnd": 310.502,
  "text": "One massive Marvel event.",
  "end": 310.54
 },
 {
  "i": 96,
  "start": 310.54,
  "speechStart": 310.69,
  "speechEnd": 312.996,
  "text": "And one villain who could change everything.",
  "end": 313.225
 },
 {
  "i": 97,
  "start": 313.225,
  "speechStart": 313.375,
  "speechEnd": 315.599,
  "text": "Of course,",
  "end": 315.975
 },
 {
  "i": 98,
  "start": 315.975,
  "speechStart": 316.125,
  "speechEnd": 320.274,
  "text": "this is a recommended shortlist, not an officially confirmed list of movies required to understand Avengers:",
  "end": 320.635
 },
 {
  "i": 99,
  "start": 320.635,
  "speechStart": 320.785,
  "speechEnd": 321.34,
  "text": "Doomsday.",
  "end": 321.565
 },
 {
  "i": 100,
  "start": 321.565,
  "speechStart": 321.715,
  "speechEnd": 323.597,
  "text": "Now I have one question for you.",
  "end": 323.802
 },
 {
  "i": 101,
  "start": 323.802,
  "speechStart": 323.952,
  "speechEnd": 327.164,
  "text": "Do you think Doctor Doom will be more dangerous than Thanos?",
  "end": 327.376
 },
 {
  "i": 102,
  "start": 327.376,
  "speechStart": 327.526,
  "speechEnd": 329.036,
  "text": "Let me know in the comments!",
  "end": 329.249
 },
 {
  "i": 103,
  "start": 329.249,
  "speechStart": 329.399,
  "speechEnd": 331.037,
  "text": "And if you're a true Marvel fan,",
  "end": 330.989
 },
 {
  "i": 104,
  "start": 330.989,
  "speechStart": 331.139,
  "speechEnd": 333.939,
  "text": "hit that like button,",
  "end": 334.339
 },
 {
  "i": 105,
  "start": 334.339,
  "speechStart": 334.489,
  "speechEnd": 336.422,
  "text": "subscribe for more MCU updates, and turn on notifications.",
  "end": 336.666
 },
 {
  "i": 106,
  "start": 336.666,
  "speechStart": 336.816,
  "speechEnd": 338.291,
  "text": "Because when Doom arrives…",
  "end": 338.866
 },
 {
  "i": 107,
  "start": 338.866,
  "speechStart": 339.016,
  "speechEnd": 341.702,
  "text": "The entire Marvel universe could change forever.",
  "end": 341.926
 },
 {
  "i": 108,
  "start": 341.926,
  "speechStart": 342.076,
  "speechEnd": 343.507,
  "text": "See you in the next video!",
  "end": 345.007
 }
]